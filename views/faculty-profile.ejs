<section class="hero hero-compact">
    <div class="hero-split">
        <div>
            <span class="hero-eyebrow">Faculty</span>
            <h1 class="page-title">My faculty profile</h1>
            <p class="page-sub">This information is shown to students on the browsing page.</p>
        </div>
        <a class="btn btn-ghost" href="/faculty/dashboard">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back
        </a>
    </div>
</section>

<div class="profile-wrap">

    <!-- ============ LEFT: FORM ============ -->
    <form method="post" action="/faculty/profile" class="profile-form panel">
        <div class="panel-head">
            <div class="panel-head-icon panel-head-icon-blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div>
                <h2 class="panel-title">Edit your information</h2>
                <p class="panel-sub">Changes appear immediately to students.</p>
            </div>
        </div>

        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="readonly-row">
            <div>
                <span class="readonly-label">Department</span>
                <div class="readonly-value"><%= profile.department %></div>
            </div>
            <span class="readonly-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Admin-only
            </span>
        </div>

        <label class="field">
            <span>Office location <em>(optional)</em></span>
            <input type="text" name="office_location" maxlength="100"
                   value="<%= profile.office_location || '' %>"
                   placeholder="e.g. Room 304, Tech Building">
        </label>

        <label class="field">
            <span>Consultation mode</span>
            <select name="consultation_mode">
                <% ['In-Person', 'Online', 'Hybrid'].forEach(m => { %>
                    <option value="<%= m %>" <%= profile.consultation_mode === m ? 'selected' : '' %>>
                        <%= m %>
                    </option>
                <% }) %>
            </select>
        </label>

        <label class="field">
            <span>Short bio <em>(max 1000 characters)</em></span>
            <textarea name="bio" rows="5" maxlength="1000"
                      placeholder="Tell students about your areas of expertise and how you like to run consultations."><%= profile.bio || '' %></textarea>
        </label>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <path d="M17 21v-8H7v8M7 3v5h8"/>
                </svg>
                Save changes
            </button>
        </div>
    </form>

    <!-- ============ RIGHT: PREVIEW + TIP ============ -->
    <aside class="profile-side">

        <!-- Live preview card -->
        <div class="panel">
            <h3 class="panel-title" style="margin-bottom:.25rem">Live preview</h3>
            <p class="panel-sub" style="margin-bottom:1rem">This is how students see your card.</p>

            <article class="faculty-card preview-card">
                <header class="card-head">
                    <div class="avatar"><%= user.full_name.replace(/^(Dr|Prof|Mr|Ms|Mrs)\.?\s+/i,'').split(/\s+/).slice(0,2).map(n => n[0]).join('').toUpperCase() %></div>
                    <div class="card-identity">
                        <h2 class="card-name"><%= user.full_name %></h2>
                        <p class="card-dept"><%= profile.department %></p>
                    </div>
                </header>
                <div class="card-badges">
                    <span class="badge badge-mode"><%= profile.consultation_mode %></span>
                </div>
                <% if (profile.office_location) { %>
                    <p class="card-meta"><strong>Office:</strong> <%= profile.office_location %></p>
                <% } %>
                <% if (profile.bio) { %>
                    <p class="card-bio"><%= profile.bio.length > 150 ? profile.bio.slice(0, 150) + '…' : profile.bio %></p>
                <% } %>
            </article>
        </div>

        <!-- Next step info box -->
        <div class="panel panel-info">
            <strong>Next step</strong>
            <p style="margin:.35rem 0 0; font-size:.9rem">
                Publish your weekly consultation hours from the
                <a href="/faculty/schedules">Schedule page</a>
                so students can book a slot with you.
            </p>
        </div>
    </aside>
</div>