<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> — Faculink</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
</head>
<body>
    <%- include('partials/header') %>

    <% if (locals.isAuthPage) { %>
        <%- body %>
    <% } else { %>
        <main class="container page">
            <%- body %>
        </main>
    <% } %>

    <%- include('partials/footer') %>

    <span id="flash-success" style="display:none;"><%= typeof success !== 'undefined' && success.length > 0 ? success[0] : '' %></span>
    <span id="flash-error" style="display:none;"><%= typeof error !== 'undefined' && error.length > 0 ? error[0] : '' %></span>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var successSpan = document.getElementById('flash-success');
            var errorSpan = document.getElementById('flash-error');

            var successMsg = successSpan ? successSpan.textContent.trim() : '';
            var errorMsg = errorSpan ? errorSpan.textContent.trim() : '';

            if (successMsg !== '') {
                Toastify({
                    text: successMsg,
                    duration: 3000,
                    close: true,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #00b09b, #96c93d)", zIndex: 9999 }
                }).showToast();
            }

            if (errorMsg !== '') {
                Toastify({
                    text: errorMsg,
                    duration: 3000,
                    close: true,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)", zIndex: 9999 }
                }).showToast();
            }
        });
    </script>
</body>
</html>