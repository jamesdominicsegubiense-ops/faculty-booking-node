<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="/">
            <span class="brand-mark">FC</span>
            <span class="brand-text">Faculink</span>
        </a>
        <nav class="main-nav">
            <a href="/">Home</a>
            <% if (user) { %>
                <% if (user.role === 'faculty') { %>
                    <a href="/faculty/dashboard">Dashboard</a>
                    <a href="/faculty/schedules">Schedule</a>
                    <a href="/faculty/profile">Profile</a>
                <% } else if (user.role === 'student') { %>
                    <a href="/my-bookings">My Bookings</a>
                <% } else if (user.role === 'admin') { %>
                    <a href="/admin/dashboard">Admin Panel</a>
                    <a href="/admin/faculty-report">Report</a>
                <% } %>
                <span class="user-chip">
                    <%= user.full_name %>
                    <em><%= user.role %></em>
                </span>
                <a class="btn btn-ghost btn-sm" href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a class="btn btn-primary btn-sm" href="/register">Register</a>
            <% } %>
        </nav>
    </div>
</header>