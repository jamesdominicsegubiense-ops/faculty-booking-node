<div class="auth-shell">
    <aside class="auth-brand">
        <div class="auth-brand-body">
            <h2 class="auth-brand-title">Faculink</h2>
            <p class="auth-brand-sub">
                Faculty Consultation Booking System
                <span class="auth-brand-tagline">"Making Academic Consultations Easier."</span>
            </p>
            <ul class="auth-features">
                <li><span class="feature-dot"></span>Browse faculty availability in real time</li>
                <li><span class="feature-dot"></span>Pick a slot that fits your schedule</li>
                <li><span class="feature-dot"></span>Track every request from pending to completed</li>
            </ul>
        </div>
        <div class="auth-brand-foot">
            <span>© <%= new Date().getFullYear() %> Faculty Consult</span>
        </div>
    </aside>
    <section class="auth-form-panel">
        <div class="auth-form-inner">
            <h1 class="auth-title">Create your account</h1>
            <p class="auth-sub">Sign up as a student to start booking consultations.</p>
            
            <% if (errors && errors.length) { %>
                <div class="alert alert-error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
            <% } %>
            
            <form method="post" action="/register" class="stack">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                
                <label class="field">
                    <span>Full name</span>
                    <input type="text" name="full_name" maxlength="100" required value="<%= old.full_name || '' %>" placeholder="Juan Dela Cruz">
                </label>
                
                <label class="field">
                    <span>Email address</span>
                    <input type="email" name="email" maxlength="150" required value="<%= old.email || '' %>" placeholder="you@student.edu">
                </label>
                
                <div class="field-row">
                    <label class="field">
                        <span>Password</span>
                        <div class="password-wrap">
                            <input type="password" name="password" id="regPassword" required placeholder="Enter your password" minlength="8">
                            <button type="button" class="password-toggle" id="togglePassBtn">👁</button>
                        </div>
                        <div id="password-strength" style="font-size: 0.75rem; margin-top: 4px; color: var(--muted);">
                            Strength: <span id="strength-text" style="font-weight: bold;">None</span>
                        </div>
                    </label>
                    
                    <label class="field">
                        <span>Confirm password</span>
                        <div class="password-wrap">
                            <input type="password" name="password_confirm" id="regPasswordConfirm" required placeholder="Confirm your password" minlength="8">
                            <button type="button" class="password-toggle" id="togglePassConfirmBtn">👁</button>
                        </div>
                    </label>
                </div>
                
                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1rem;">Create account</button>
            </form>
            
            <div class="auth-divider"><span>or</span></div>
            
            <p class="auth-foot">Already have an account? <a href="/login" class="auth-link">Sign in</a></p>
            
            <div class="demo-box demo-box-note">
                <strong>Faculty or admin?</strong>
                <p class="muted small" style="margin:.3rem 0 .75rem">
                    Faculty accounts are created by the administrator.
                </p>
                <a class="btn btn-primary btn-sm" href="https://mail.google.com/mail/?view=cm&to=admin@university.edu&su=Faculty%20Account%20Request" target="_blank" rel="noopener">
                    Contact admin via Gmail
                </a>
            </div>
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var togglePassBtn = document.getElementById('togglePassBtn');
        var togglePassConfirmBtn = document.getElementById('togglePassConfirmBtn');
        var passInput = document.getElementById('regPassword');
        var passConfirmInput = document.getElementById('regPasswordConfirm');
        var strengthText = document.getElementById('strength-text');

        if (togglePassBtn) {
            togglePassBtn.addEventListener('click', function() {
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    togglePassBtn.classList.add('is-visible');
                } else {
                    passInput.type = 'password';
                    togglePassBtn.classList.remove('is-visible');
                }
            });
        }

        if (togglePassConfirmBtn) {
            togglePassConfirmBtn.addEventListener('click', function() {
                if (passConfirmInput.type === 'password') {
                    passConfirmInput.type = 'text';
                    togglePassConfirmBtn.classList.add('is-visible');
                } else {
                    passConfirmInput.type = 'password';
                    togglePassConfirmBtn.classList.remove('is-visible');
                }
            });
        }

        if (passInput && strengthText) {
            passInput.addEventListener('input', function(e) {
                var password = e.target.value;
                
                if (password.length === 0) {
                    strengthText.textContent = 'None';
                    strengthText.style.color = 'gray';
                } else if (password.length < 6) {
                    strengthText.textContent = 'Weak';
                    strengthText.style.color = '#a4262c';
                } else if (password.length < 10) {
                    strengthText.textContent = 'Medium';
                    strengthText.style.color = '#9a6700';
                } else {
                    strengthText.textContent = 'Strong';
                    strengthText.style.color = '#1c7c54';
                }
            });
        }
    });
</script>